# Create bot with @BotFather and paste token here
TELEGRAM_BOT_TOKEN=123456789:replace_me
# Your numeric Telegram user ID, not @username
TELEGRAM_USER_ID=123456789
# Base Matrix client-server URL, no trailing /_matrix
MATRIX_HOMESERVER=https://matrix.example.org
# Dedicated Matrix bot account (must match the token's acting user)
MATRIX_USER_ID=@stickers:example.org
MATRIX_ACCESS_TOKEN=replace_me

# Room uploads are the default. Use personal only for explicit legacy compatibility.
MATRIX_PACK_MODE=room
# Required in room mode: shared room for the bot and your personal Matrix account.
# Join as the bot, give it room state permissions, and paste the exact !room_id
# Copy the exact ID: v12 IDs have no :server suffix. Do not append a domain.
MATRIX_PACK_ROOM_ID=!replace_with_exact_room_id
