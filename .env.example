# Create bot with @BotFather and paste token here
TELEGRAM_BOT_TOKEN=123456789:replace_me
# Your numeric Telegram user ID, not @username
TELEGRAM_USER_ID=123456789
# Base Matrix client-server URL, no trailing /_matrix
MATRIX_HOMESERVER=https://matrix.example.org
# Your Matrix user (the account you use in Sable)
MATRIX_USER_ID=@alice:example.org
MATRIX_ACCESS_TOKEN=replace_me

# Optional but recommended for standardized image packs:
# Create a private Matrix room containing only yourself, and paste its !room_id
# MATRIX_PACK_ROOM_ID=!abcdef:example.org
BACKUP_DIR=./backups
